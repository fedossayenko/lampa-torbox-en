<?xml version="1.0" encoding="UTF-8"?>
<!-- Voice search's Claude Code on the old MacBook (voice-claude.py), kept running in the user's session (the
     keychain holds Claude Code's sign-in). Install: scp voice-claude.py voice-prompt.json <mac>:lampa-intros/ and
     this to ~/Library/LaunchAgents/local.lampa-voice.plist there; launchctl bootstrap gui/$(id -u) <that plist>. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>local.lampa-voice</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec /usr/bin/python3 "$HOME/lampa-intros/voice-claude.py" &gt;&gt; "$HOME/.lampa-intros/voice.log" 2&gt;&amp;1</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>30</integer>
</dict>
</plist>
